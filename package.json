{
  "name": "next-express-app",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "next start",
    "dev:client": "npm run dev --prefix client -- -p 3000",
    "dev:server": "npm run dev --prefix server",
    "dev": "concurrently -k -s first -n \"client,server\" -c \"cyan,green\" \"npm run dev:client\" \"npm run dev:server\""
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "next": "^16.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
